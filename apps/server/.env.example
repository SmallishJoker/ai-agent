OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Embedding（语义记忆用；留空则自动降级为按重要性检索）
# 示例：DashScope 兼容模式 text-embedding-v4
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
# 输出维度，必须与 user_memories.embedding 列一致（默认 1536）
EMBEDDING_DIMENSIONS=1536

DATABASE_URL=

# 记忆系统配置（可选，均有默认值）
# 保留在上下文中的最近消息条数
MEMORY_RECENT_MESSAGES=10
# 触发摘要所需的最少新增消息条数
MEMORY_SUMMARY_BATCH=10
# 注入 Prompt 的用户长期记忆条数上限（语义检索不可用时的降级条数）
USER_MEMORY_LIMIT=20
# 语义检索召回的 Top-K 条数
SEMANTIC_TOP_K=5

# Agent 运行预算（可选）
# 单次对话最多「模型↔工具」步数
AGENT_MAX_STEPS=5
# 单次对话最多工具调用次数
AGENT_MAX_TOOL_CALLS=10